        <Field Name="ValorTotal"><DataField>ValorTotal</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalImpostos"><DataField>TotalImpostos</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalCliente"><DataField>TotalCliente</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="QuantidadeCliente"><DataField>QuantidadeCliente</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="TotalGeral"><DataField>TotalGeral</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalGeralImpostos"><DataField>TotalGeralImpostos</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="QuantidadeTotal"><DataField>QuantidadeTotal</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
      </Fields>
      <Query>
        <DataSourceName>ObjectDataSource</DataSourceName>
        <CommandText />
