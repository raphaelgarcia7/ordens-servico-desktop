  <Body>
    <ReportItems>
      <Textbox Name="Titulo">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Relatório Gerencial de Ordens de Serviço</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
        <Top>0.1in</Top><Left>0.1in</Left><Height>0.3in</Height><Width>7.4in</Width><Style />
      </Textbox>
      <Tablix Name="TabelaOrdens">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>2.2in</Width></TablixColumn>
            <TablixColumn><Width>1.2in</Width></TablixColumn>
            <TablixColumn><Width>1.2in</Width></TablixColumn>
            <TablixColumn><Width>1.2in</Width></TablixColumn>
            <TablixColumn><Width>1.2in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow><Height>0.24in</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="HId"><Paragraphs><Paragraph><TextRuns><TextRun><Value>OS</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="HCliente"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Cliente</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="HData"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Data</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="HStatus"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Status</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="HValor"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Valor</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="HImp"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Impostos</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
            <TablixRow><Height>0.22in</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="DId"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!OrdemServicoId.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="DCliente"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ClienteNome.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="DData"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!DataAbertura.Value, "dd/MM/yyyy")</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="DStatus"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Status.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="DValor"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ValorTotal.Value</Value><Style><Format>C2</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="DImp"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TotalImpostos.Value</Value><Style><Format>C2</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
            <TablixRow><Height>0.25in</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="F1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total geral</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="FQtd"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows()</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="F2"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="F3"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="FTotal"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!ValorTotal.Value)</Value><Style><Format>C2</Format><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="FImp"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!TotalImpostos.Value)</Value><Style><Format>C2</Format><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="Detalhes" /></TablixMember><TablixMember><KeepWithGroup>Before</KeepWithGroup></TablixMember></TablixMembers></TablixRowHierarchy>
